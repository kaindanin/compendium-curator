<section class="cc-table-profile-editor">
    <div class="cc-table-profile-configuration">
        <section class="cc-table-profile-editor-section">
            <div
                class="cc-table-filter-detail-block cc-table-profile-editor-general"
            >
                <div
                    class="cc-table-filter-detail-choice cc-table-profile-editor-row"
                >
                    <label for="cc-table-profile-name">
                        {{localize
                            "COMPENDIUM_CURATOR.TableProfileName"
                        }}
                    </label>

                    <div class="form-fields">
                        <input
                            id="cc-table-profile-name"
                            type="text"
                            name="profileName"
                            value="{{profileName}}"
                            autocomplete="off"
                            autofocus
                        >
                    </div>
                </div>
            </div>
        </section>
    </div>

    <footer
        class="cc-table-profile-footer"
        style="justify-content: flex-end; gap: 0.5rem;"
    >
        <button
            type="button"
            data-action="cancel"
            style="flex: 0 0 auto; width: auto; min-width: 96px; padding-inline: 1rem;"
        >
            {{localize "COMPENDIUM_CURATOR.Cancel"}}
        </button>

        <button
            type="button"
            data-action="save"
            style="flex: 0 0 auto; width: auto; min-width: 96px; padding-inline: 1rem;"
        >
            {{localize "COMPENDIUM_CURATOR.Create"}}
        </button>
    </footer>
</section>
