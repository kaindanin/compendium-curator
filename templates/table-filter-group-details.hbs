<div class="cc-table-filter-group-details">

    {{#if exists}}

        <header
            class="cc-table-filter-group-details-header"
        >

            <h2>
                {{groupName}}
            </h2>

            <div class="cc-table-filter-group-usage">

                <strong>
                    {{localize
                        "COMPENDIUM_CURATOR.FilterGroupUsedBy"
                    }}
                </strong>

                {{#if hasUsage}}

                    <div class="cc-table-manager-filter-groups">

                        {{#each usedBy}}

                            <div
                                class="cc-table-manager-filter-group"
                            >
                                <i class="fas fa-link"></i>

                                <span>
                                    {{name}}
                                </span>
                            </div>

                        {{/each}}

                    </div>

                {{else}}

                    <p class="hint">
                        {{localize
                            "COMPENDIUM_CURATOR.FilterGroupUnused"
                        }}
                    </p>

                {{/if}}

            </div>

        </header>


        <section>

            <h3>
                {{localize
                    "COMPENDIUM_CURATOR.SavedFilters"
                }}
            </h3>

            {{#if hasFilters}}

                <div
                    class="cc-table-filter-details-blocks"
                >

                    {{#each filterGroups}}

                        <div
                            class="cc-table-filter-detail-block"
                        >

                            <div
                                class="cc-table-filter-detail-heading"
                            >

                                <strong>
                                    {{label}}
                                </strong>

                                {{#if single}}

                                    {{#if filterState}}
                                        <filter-state
                                            class="cc-table-filter-detail-state"
                                            value="{{value}}"
                                            disabled
                                        ></filter-state>
                                    {{else}}
                                        <span
                                            class="cc-table-filter-detail-state"
                                        >
                                            {{value}}
                                        </span>
                                    {{/if}}

                                {{/if}}

                            </div>

                            {{#unless single}}

                                <div
                                    class="cc-table-filter-detail-choices"
                                >

                                    {{#each entries}}

                                        <div
                                            class="cc-table-filter-detail-choice"
                                        >

                                            <span>
                                                {{label}}
                                            </span>

                                            {{#if filterState}}
                                                <filter-state
                                                    class="cc-table-filter-detail-state"
                                                    value="{{value}}"
                                                    disabled
                                                ></filter-state>
                                            {{else}}
                                                <strong>
                                                    {{value}}
                                                </strong>
                                            {{/if}}

                                        </div>

                                    {{/each}}

                                </div>

                            {{/unless}}

                        </div>

                    {{/each}}

                </div>

            {{else}}

                <p class="hint">
                    {{localize
                        "COMPENDIUM_CURATOR.NoAdditionalFilters"
                    }}
                </p>

            {{/if}}

        </section>


        <section
            class="cc-table-filter-group-matches"
        >

            <div
                class="cc-table-filter-group-matches-title"
            >

                <h3>
                    {{localize
                        "COMPENDIUM_CURATOR.SavedMatches"
                    }}
                </h3>

                <strong>
                    {{matchCount}}
                </strong>

            </div>


            {{#if hasMatches}}

                <section
                    class="inventory-element cc-dnd5e-document-list"
                >

                    <section
                        class="items-list browser-results"
                    >

                        <div
                            class="items-section card"
                        >

                            <div
                                class="items-header header"
                            >

                                <h3 class="item-name">
                                    {{localize
                                        "DND5E.CompendiumBrowser.Column.Results"
                                    }}
                                </h3>

                                <div
                                    class="item-header item-source"
                                >
                                    {{localize
                                        "DND5E.CompendiumBrowser.Column.Source"
                                    }}
                                </div>

                                <div
                                    class="item-header item-controls"
                                ></div>

                            </div>


                            <ol class="item-list unlist">

                                {{#each matches}}

                                    <li
                                        class="item cc-dnd5e-document-entry"
                                        data-uuid="{{uuid}}"
                                    >

                                        <div class="item-row">

                                            <div
                                                class="item-name rollable"
                                                role="button"
                                                data-cc-open-document
                                            >

                                                {{#if img}}

                                                    <img
                                                        class="item-image gold-icon"
                                                        loading="lazy"
                                                        src="{{img}}"
                                                        alt="{{name}}"
                                                        draggable="false"
                                                    >

                                                {{/if}}

                                                <div
                                                    class="name name-stacked"
                                                >

                                                    <span class="title">
                                                        {{name}}
                                                    </span>

                                                    {{#if subtitle}}

                                                        <span class="subtitle">
                                                            {{localize subtitle}}
                                                        </span>

                                                    {{/if}}

                                                </div>

                                            </div>


                                            <div
                                                class="
                                                    item-detail
                                                    item-source
                                                    {{#unless source}}empty{{/unless}}
                                                "
                                            >

                                                {{#if source}}

                                                    <span class="condensed">
                                                        {{source}}
                                                    </span>

                                                {{/if}}

                                            </div>


                                            <div
                                                class="
                                                    item-detail
                                                    item-controls
                                                "
                                            ></div>

                                        </div>

                                    </li>

                                {{/each}}

                            </ol>

                        </div>

                    </section>

                </section>

            {{else}}

                <p class="hint">
                    {{localize
                        "COMPENDIUM_CURATOR.NoMatchingObjects"
                    }}
                </p>

            {{/if}}

        </section>

    {{else}}

        <p class="hint">
            {{localize
                "COMPENDIUM_CURATOR.FilterGroupNotFound"
            }}
        </p>

    {{/if}}

</div>
