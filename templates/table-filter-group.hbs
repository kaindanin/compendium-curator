<div class="cc-table-filter-group">

    {{#if isCreateMode}}

        <div
            class="cc-table-filter-group-content"
            style="overflow-y: auto; gap: 0.8rem;"
        >

            <header>

                <h2 style="margin: 0;">
                    {{localize
                        "COMPENDIUM_CURATOR.FilterGroups"
                    }}
                </h2>

                <p class="hint cc-table-filter-group-intro">
                    {{#if linkToProfile}}

                        {{localize
                            "COMPENDIUM_CURATOR.AddFilterGroupHint"
                            profile=profileName
                        }}

                    {{else}}

                        {{localize
                            "COMPENDIUM_CURATOR.LivePreviewHint"
                        }}

                    {{/if}}
                </p>

            </header>


            <section class="cc-table-profile-editor-section">

                <div
                    class="
                        cc-table-filter-detail-block
                        cc-table-profile-editor-general
                    "
                >

                    <div
                        class="
                            cc-table-filter-detail-choice
                            cc-table-profile-editor-row
                        "
                    >

                        <label for="cc-table-filter-group-name">
                            {{localize
                                "COMPENDIUM_CURATOR.FilterGroupName"
                            }}
                        </label>

                        <div class="form-fields">

                            <input
                                id="cc-table-filter-group-name"
                                type="text"
                                name="filterGroupName"
                                value="{{filterGroupName}}"
                                autocomplete="off"
                            >

                        </div>

                    </div>

                </div>

            </section>


            <section>

                <h3
                    style="
                        margin: 0 0 0.55rem;
                        padding-bottom: 0.4rem;
                        border-bottom: 1px solid rgb(255 255 255 / 10%);
                        font-family: var(--dnd5e-font-roboto-slab);
                        font-size: 1.05rem;
                        line-height: 1.2;
                    "
                >
                    {{localize
                        "COMPENDIUM_CURATOR.LivePreview"
                    }}
                </h3>

                {{#if hasFilters}}

                    <div class="cc-table-filter-details-blocks">

                        {{#each filterGroups}}

                            <div
                                class="cc-table-filter-detail-block"
                            >

                                <div
                                    class="cc-table-filter-detail-heading"
                                >

                                    <strong>
                                        {{label}}
                                    </strong>

                                    {{#if single}}

                                        <span
                                            class="cc-table-filter-detail-state"
                                        >
                                            {{value}}
                                        </span>

                                    {{/if}}

                                </div>

                                {{#unless single}}

                                    <div
                                        class="cc-table-filter-detail-choices"
                                    >

                                        {{#each entries}}

                                            <div
                                                class="cc-table-filter-detail-choice"
                                            >

                                                <span>
                                                    {{label}}
                                                </span>

                                                <strong>
                                                    {{value}}
                                                </strong>

                                            </div>

                                        {{/each}}

                                    </div>

                                {{/unless}}

                            </div>

                        {{/each}}

                    </div>

                {{else}}

                    {{#unless isPreviewLoading}}

                        <p class="hint">
                            {{localize
                                "COMPENDIUM_CURATOR.NoAdditionalFilters"
                            }}
                        </p>

                    {{/unless}}

                {{/if}}

            </section>


            <section
                class="cc-table-filter-group-matches"
                data-cc-live-preview
                style="min-height: 0;"
            >

                <div
                    class="cc-table-filter-group-matches-title"
                    style="
                        margin-bottom: 0.55rem;
                        padding-bottom: 0.4rem;
                        border-bottom: 1px solid rgb(255 255 255 / 10%);
                    "
                >

                    <h3
                        style="
                            margin: 0;
                            font-family: var(--dnd5e-font-roboto-slab);
                            font-size: 1.05rem;
                            line-height: 1.2;
                        "
                    >
                        {{localize
                            "COMPENDIUM_CURATOR.FinalObjects"
                        }}
                    </h3>

                    <div
                        style="
                            display: flex;
                            align-items: center;
                            gap: 0.5rem;
                        "
                    >

                        <span
                            data-cc-preview-loading
                            {{#unless isPreviewLoading}}
                                hidden
                            {{/unless}}
                        >
                            <i
                                class="
                                    fas
                                    fa-spinner
                                    fa-spin
                                "
                            ></i>
                        </span>

                        <strong>
                            {{matchCount}}
                        </strong>

                    </div>

                </div>


                {{#if hasMatches}}

                    <ol
                        class="cc-table-filter-group-live-results"
                        style="
                            max-height: 320px;
                            margin: 0;
                            padding: 0.25rem 0.65rem 0.25rem 2.75rem;
                            background: var(--dnd5e-background-card);
                            border: 0;
                            border-radius: 5px;
                            overflow-x: hidden;
                            overflow-y: auto;
                            scrollbar-gutter: stable;
                        "
                    >

                        {{#each matches}}

                            <li
                                style="
                                    min-height: 32px;
                                    padding: 0.35rem 0.3rem;
                                    border-bottom: 1px solid rgb(255 255 255 / 5%);
                                    line-height: 1.25;
                                "
                            >
                                <span>
                                    {{name}}
                                </span>
                            </li>

                        {{/each}}

                    </ol>

                    {{#if previewTruncated}}

                        <p
                            class="hint"
                            style="
                                margin:
                                    0.5rem
                                    0
                                    0;
                                text-align: right;
                            "
                        >
                            {{localize
                                "COMPENDIUM_CURATOR.LivePreview"
                            }}:
                            {{previewCount}}
                            /
                            {{matchCount}}
                        </p>

                    {{/if}}

                {{else}}

                    {{#unless isPreviewLoading}}

                        <p class="hint">
                            {{localize
                                "COMPENDIUM_CURATOR.NoMatchingObjects"
                            }}
                        </p>

                    {{/unless}}

                {{/if}}

            </section>

        </div>


        <footer
            class="cc-table-profile-footer"
            style="
                justify-content: flex-end;
                gap: 0.5rem;
            "
        >

            <button
                type="button"
                data-action="cancel"
                style="
                    flex: 0 0 auto;
                    width: auto;
                    min-width: 88px;
                    padding-inline: 0.9rem;
                "
            >
                {{localize
                    "COMPENDIUM_CURATOR.Cancel"
                }}
            </button>

            <button
                type="button"
                data-action="create"
                style="
                    flex: 0 0 auto;
                    width: auto;
                    min-width: 88px;
                    padding-inline: 0.9rem;
                "
                {{#if isPreviewLoading}}
                    disabled
                {{else}}
                    {{#unless hasMatches}}
                        disabled
                    {{/unless}}
                {{/if}}
            >
                {{localize
                    "COMPENDIUM_CURATOR.Create"
                }}
            </button>

        </footer>

    {{else}}

        <div class="cc-table-filter-group-content">

            {{#if exists}}

                <header>

                    <h2>
                        {{profileName}}
                    </h2>

                    <p
                        class="hint cc-table-filter-group-intro"
                        data-cc-selected-count
                    >
                        {{localize
                            "COMPENDIUM_CURATOR.FilterGroupCount"
                            count=selectedCount
                        }}
                    </p>

                </header>


                {{#if hasGroups}}

                    <div class="cc-table-manager-profiles">

                        {{#each groups}}

                            <label
                                class="cc-table-manager-filter-group"
                            >

                                <input
                                    type="checkbox"
                                    name="filterGroupIds"
                                    value="{{id}}"
                                    style="border: 0; box-shadow: none; outline: none;"
                                    {{#if checked}}
                                        checked
                                    {{/if}}
                                >

                                <span>
                                    {{name}}
                                </span>

                                <small>
                                    <i class="fas fa-filter"></i>
                                    {{matchCount}}

                                    &nbsp;·&nbsp;

                                    <i class="fas fa-link"></i>
                                    {{useCount}}
                                </small>

                            </label>

                        {{/each}}

                    </div>

                {{else}}

                    <p class="hint">
                        {{localize
                            "COMPENDIUM_CURATOR.NoFilterGroups"
                        }}
                    </p>

                {{/if}}


                <button
                    type="button"
                    data-action="createCurrentFilters"
                >
                    <i class="fas fa-plus"></i>

                    {{localize
                        "COMPENDIUM_CURATOR.AddCurrentFilters"
                    }}
                </button>

            {{else}}

                <p class="hint">
                    {{localize
                        "COMPENDIUM_CURATOR.ProfileNameInvalid"
                    }}
                </p>

            {{/if}}

        </div>


        <footer class="cc-table-filter-group-footer">

            <button
                type="button"
                data-action="cancel"
            >
                <i class="fas fa-xmark"></i>

                {{localize
                    "COMPENDIUM_CURATOR.TableDefaultsCancel"
                }}
            </button>

            <button
                type="button"
                data-action="save"
                {{#unless exists}}
                    disabled
                {{/unless}}
            >
                <i class="fas fa-check"></i>

                {{localize
                    "COMPENDIUM_CURATOR.Save"
                }}
            </button>

        </footer>

    {{/if}}

</div>