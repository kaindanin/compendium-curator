<div class="cc-table-filter-group">

    {{#if isCreateMode}}

        <div
            class="cc-table-filter-group-content"
            style="overflow-y: auto;"
        >

            <header>

                <h2 style="margin: 0;">
                    {{localize
                        "COMPENDIUM_CURATOR.LivePreview"
                    }}
                </h2>

                <p class="hint cc-table-filter-group-intro">
                    {{#if linkToProfile}}

                        {{localize
                            "COMPENDIUM_CURATOR.AddFilterGroupHint"
                            profile=profileName
                        }}

                    {{else}}

                        {{localize
                            "COMPENDIUM_CURATOR.LivePreviewHint"
                        }}

                    {{/if}}
                </p>

            </header>


            <section class="cc-table-profile-editor-section">

                <div
                    class="
                        cc-table-filter-detail-block
                        cc-table-profile-editor-general
                    "
                >

                    <div
                        class="
                            cc-table-filter-detail-choice
                            cc-table-profile-editor-row
                        "
                    >

                        <label for="cc-table-filter-group-name">
                            {{localize
                                "COMPENDIUM_CURATOR.FilterGroupName"
                            }}
                        </label>

                        <div class="form-fields">

                            <input
                                id="cc-table-filter-group-name"
                                type="text"
                                name="filterGroupName"
                                value="{{filterGroupName}}"
                                autocomplete="off"
                            >

                        </div>

                    </div>

                </div>

            </section>


            {{#if hasFilters}}

                <div class="cc-table-filter-details-blocks">

                    {{#each filterGroups}}

                        <div
                            class="cc-table-filter-detail-block"
                        >

                            <div
                                class="cc-table-filter-detail-heading"
                            >

                                <strong>
                                    {{label}}
                                </strong>

                                {{#if single}}

                                    <span
                                        class="cc-table-filter-detail-state"
                                    >
                                        {{value}}
                                    </span>

                                {{/if}}

                            </div>

                            {{#unless single}}

                                <div
                                    class="cc-table-filter-detail-choices"
                                >

                                    {{#each entries}}

                                        <div
                                            class="cc-table-filter-detail-choice"
                                        >

                                            <span>
                                                {{label}}
                                            </span>

                                            <strong>
                                                {{value}}
                                            </strong>

                                        </div>

                                    {{/each}}

                                </div>

                            {{/unless}}

                        </div>

                    {{/each}}

                </div>

            {{else}}

                <p class="hint">
                    {{localize
                        "COMPENDIUM_CURATOR.NoAdditionalFilters"
                    }}
                </p>

            {{/if}}


            <section
                class="cc-table-filter-group-matches"
            >

                <div
                    class="cc-table-filter-group-matches-title"
                >

                    <h3>
                        {{localize
                            "COMPENDIUM_CURATOR.FinalObjects"
                        }}
                    </h3>

                    <strong>
                        {{matchCount}}
                    </strong>

                </div>


                {{#if hasMatches}}

                    <section
                        class="inventory-element cc-dnd5e-document-list"
                    >

                        <section
                            class="items-list browser-results"
                        >

                            <div
                                class="items-section card"
                            >

                                <div
                                    class="items-header header"
                                >

                                    <h3 class="item-name">
                                        {{localize
                                            "DND5E.CompendiumBrowser.Column.Results"
                                        }}
                                    </h3>

                                    <div
                                        class="item-header item-source"
                                    >
                                        {{localize
                                            "DND5E.CompendiumBrowser.Column.Source"
                                        }}
                                    </div>

                                    <div
                                        class="item-header item-controls"
                                    ></div>

                                </div>


                                <ol class="item-list unlist">

                                    {{#each matches}}

                                        <li
                                            class="item cc-dnd5e-document-entry"
                                            data-uuid="{{uuid}}"
                                        >

                                            <div class="item-row">

                                                <div
                                                    class="item-name rollable"
                                                    role="button"
                                                    data-cc-open-document
                                                >

                                                    {{#if img}}

                                                        <img
                                                            class="item-image gold-icon"
                                                            loading="lazy"
                                                            src="{{img}}"
                                                            alt="{{name}}"
                                                            draggable="false"
                                                        >

                                                    {{/if}}

                                                    <div
                                                        class="name name-stacked"
                                                    >

                                                        <span class="title">
                                                            {{name}}
                                                        </span>

                                                        {{#if subtitle}}

                                                            <span class="subtitle">
                                                                {{localize subtitle}}
                                                            </span>

                                                        {{/if}}

                                                    </div>

                                                </div>


                                                <div
                                                    class="
                                                        item-detail
                                                        item-source
                                                        {{#unless source}}empty{{/unless}}
                                                    "
                                                >

                                                    {{#if source}}

                                                        <span class="condensed">
                                                            {{source}}
                                                        </span>

                                                    {{/if}}

                                                </div>


                                                <div
                                                    class="
                                                        item-detail
                                                        item-controls
                                                    "
                                                ></div>

                                            </div>

                                        </li>

                                    {{/each}}

                                </ol>

                            </div>

                        </section>

                    </section>

                {{else}}

                    <p class="hint">
                        {{localize
                            "COMPENDIUM_CURATOR.NoMatchingObjects"
                        }}
                    </p>

                {{/if}}

            </section>

        </div>


        <footer
            class="cc-table-profile-footer"
            style="justify-content: flex-end; gap: 0.5rem;"
        >

            <button
                type="button"
                data-action="cancel"
                style="flex: 0 0 auto; width: auto; min-width: 96px; padding-inline: 1rem;"
            >
                {{localize
                    "COMPENDIUM_CURATOR.Cancel"
                }}
            </button>

            <button
                type="button"
                data-action="create"
                style="flex: 0 0 auto; width: auto; min-width: 96px; padding-inline: 1rem;"
                {{#unless hasMatches}}
                    disabled
                {{/unless}}
            >
                {{localize
                    "COMPENDIUM_CURATOR.Create"
                }}
            </button>

        </footer>

    {{else}}

        <div class="cc-table-filter-group-content">

            {{#if exists}}

                <header>

                    <h2>
                        {{profileName}}
                    </h2>

                    <p
                        class="hint cc-table-filter-group-intro"
                        data-cc-selected-count
                    >
                        {{localize
                            "COMPENDIUM_CURATOR.FilterGroupCount"
                            count=selectedCount
                        }}
                    </p>

                </header>


                {{#if hasGroups}}

                    <div class="cc-table-manager-profiles">

                        {{#each groups}}

                            <label
                                class="cc-table-manager-filter-group"
                            >

                                <input
                                    type="checkbox"
                                    name="filterGroupIds"
                                    value="{{id}}"
                                    style="border: 0; box-shadow: none; outline: none;"
                                    {{#if checked}}
                                        checked
                                    {{/if}}
                                >

                                <span>
                                    {{name}}
                                </span>

                                <small>
                                    <i class="fas fa-filter"></i>
                                    {{matchCount}}

                                    &nbsp;·&nbsp;

                                    <i class="fas fa-link"></i>
                                    {{useCount}}
                                </small>

                            </label>

                        {{/each}}

                    </div>

                {{else}}

                    <p class="hint">
                        {{localize
                            "COMPENDIUM_CURATOR.NoFilterGroups"
                        }}
                    </p>

                {{/if}}


                <button
                    type="button"
                    data-action="createCurrentFilters"
                >
                    <i class="fas fa-plus"></i>

                    {{localize
                        "COMPENDIUM_CURATOR.AddCurrentFilters"
                    }}
                </button>

            {{else}}

                <p class="hint">
                    {{localize
                        "COMPENDIUM_CURATOR.ProfileNameInvalid"
                    }}
                </p>

            {{/if}}

        </div>


        <footer class="cc-table-filter-group-footer">

            <button
                type="button"
                data-action="cancel"
            >
                <i class="fas fa-xmark"></i>

                {{localize
                    "COMPENDIUM_CURATOR.TableDefaultsCancel"
                }}
            </button>

            <button
                type="button"
                data-action="save"
                {{#unless exists}}
                    disabled
                {{/unless}}
            >
                <i class="fas fa-check"></i>

                {{localize
                    "COMPENDIUM_CURATOR.Save"
                }}
            </button>

        </footer>

    {{/if}}

</div>
