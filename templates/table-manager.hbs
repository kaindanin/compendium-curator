<section class="cc-table-manager">

    <header class="cc-table-manager-header">
        <div>
            <h2>{{localize "COMPENDIUM_CURATOR.TableProfiles"}}</h2>
            <p class="hint">
                {{localize "COMPENDIUM_CURATOR.TableProfilesHint"}}
            </p>
        </div>

        <div class="cc-table-manager-actions">
            <button type="button" data-action="importProfileBundle">
                <i class="fas fa-file-import"></i>
                {{localize "COMPENDIUM_CURATOR.ImportTableProfile"}}
            </button>

            <button type="button" data-action="configureDefaults">
                <i class="fas fa-gear"></i>
                {{localize "COMPENDIUM_CURATOR.TableDefaults"}}
            </button>
        </div>
    </header>

    <nav
        class="tabs"
        aria-label="{{localize 'COMPENDIUM_CURATOR.TableManagerTitle'}}"
    >
        <a
            class="item {{contentTabClass}}"
            role="button"
            data-action="changeManagerTab"
            data-tab="content"
        >
            {{localize "COMPENDIUM_CURATOR.TableManagerTabContent"}}
            <span>({{contentProfileCount}})</span>
        </a>

        <a
            class="item {{nestedTabClass}}"
            role="button"
            data-action="changeManagerTab"
            data-tab="nested"
        >
            {{localize "COMPENDIUM_CURATOR.TableManagerTabNested"}}
            <span>({{nestedProfileCount}})</span>
        </a>

        <a
            class="item {{filterGroupsTabClass}}"
            role="button"
            data-action="changeManagerTab"
            data-tab="filters"
        >
            {{localize "COMPENDIUM_CURATOR.TableManagerTabFilterGroups"}}
            <span>({{filterGroupCount}})</span>
        </a>
    </nav>

    <div class="cc-table-profile-list">
        <div class="filter-element cc-table-manager-actions">
            <search
                aria-label="{{searchLabel}}"
                style="flex: 1 1 auto;"
            >
                <input
                    type="text"
                    name="managerSearch"
                    value="{{searchQuery}}"
                    placeholder="{{searchLabel}}"
                    autocomplete="off"
                >

                <ul class="unlist controls">
                    <li>
                        <button
                            type="button"
                            class="unbutton filter-control"
                            data-action="clearManagerSearch"
                            aria-label="{{localize 'DND5E.FilterClear'}}"
                        >
                            <i class="fas fa-xmark"></i>
                        </button>
                    </li>
                </ul>
            </search>

            <button
                type="button"
                class="cc-table-manager-filter-group-control"
                data-action="createProfile"
                {{#if isFilterGroupsTab}}
                    aria-label="{{localize 'COMPENDIUM_CURATOR.CreateFilterGroup'}}"
                    title="{{localize 'COMPENDIUM_CURATOR.CreateFilterGroup'}}"
                {{else}}
                    {{#if isNestedTab}}
                        aria-label="{{localize 'COMPENDIUM_CURATOR.CreateTableProfile'}}: {{localize 'COMPENDIUM_CURATOR.TableProfileTypeNested'}}"
                        title="{{localize 'COMPENDIUM_CURATOR.CreateTableProfile'}}: {{localize 'COMPENDIUM_CURATOR.TableProfileTypeNested'}}"
                    {{else}}
                        aria-label="{{localize 'COMPENDIUM_CURATOR.CreateTableProfile'}}: {{localize 'COMPENDIUM_CURATOR.TableProfileTypeContent'}}"
                        title="{{localize 'COMPENDIUM_CURATOR.CreateTableProfile'}}: {{localize 'COMPENDIUM_CURATOR.TableProfileTypeContent'}}"
                    {{/if}}
                {{/if}}
            >
                <i class="fas fa-plus"></i>
            </button>
        </div>

        {{#if isFilterGroupsTab}}
            <div class="cc-table-manager-profiles">
                {{#if hasFilterGroups}}
                    {{#each filterGroups}}
                        <div
                            class="cc-table-manager-profile"
                            data-filter-group-id="{{id}}"
                            data-cc-search-text="{{searchText}}"
                        >
                            <div class="cc-table-manager-profile-info">
                                <strong>{{name}}</strong>
                                <span>
                                    <i class="fas fa-filter"></i>
                                    {{matchesLabel}}
                                </span>

                                {{#if usedBy.length}}
                                    <div class="cc-table-manager-filter-groups">
                                        {{#each usedBy}}
                                            <div class="cc-table-manager-filter-group">
                                                <i class="fas fa-link"></i>
                                                <span>{{name}}</span>
                                            </div>
                                        {{/each}}
                                    </div>
                                {{else}}
                                    <p class="hint">
                                        {{localize "COMPENDIUM_CURATOR.FilterGroupUnused"}}
                                    </p>
                                {{/if}}
                            </div>

                            <div class="cc-table-manager-profile-status">
                                {{usageLabel}}
                            </div>

                            <div class="cc-table-manager-filter-group-actions">
                                <button
                                    type="button"
                                    class="cc-table-manager-filter-group-control"
                                    data-action="filterGroupDetails"
                                    title="{{localize 'COMPENDIUM_CURATOR.FilterGroupDetails'}}"
                                >
                                    <i class="fas fa-info-circle"></i>
                                </button>

                                <button
                                    type="button"
                                    class="cc-table-manager-filter-group-control"
                                    data-action="refreshFilterGroup"
                                    title="{{localize 'COMPENDIUM_CURATOR.RefreshFilterGroup'}}"
                                >
                                    <i class="fas fa-arrows-rotate"></i>
                                </button>

                                <button
                                    type="button"
                                    class="cc-table-manager-filter-group-control"
                                    data-action="loadFilterGroup"
                                    title="{{localize 'COMPENDIUM_CURATOR.LoadFilterGroupFilters'}}"
                                >
                                    <i class="fas fa-arrow-up-from-bracket"></i>
                                </button>

                                <div class="cc-table-manager-profile-menu-wrapper">
                                    <button
                                        type="button"
                                        class="cc-table-manager-profile-menu-toggle"
                                        data-action="toggleProfileActions"
                                    >
                                        <i class="fas fa-gear"></i>
                                        {{localize "COMPENDIUM_CURATOR.Actions"}}
                                    </button>

                                    <div
                                        class="cc-table-manager-profile-menu"
                                        hidden
                                    >
                                        <button
                                            type="button"
                                            data-action="renameFilterGroup"
                                        >
                                            <i class="fas fa-pen"></i>
                                            {{localize "COMPENDIUM_CURATOR.RenameFilterGroup"}}
                                        </button>

                                        <button
                                            type="button"
                                            data-action="duplicateFilterGroup"
                                        >
                                            <i class="fas fa-copy"></i>
                                            {{localize "COMPENDIUM_CURATOR.DuplicateFilterGroup"}}
                                        </button>

                                        <div class="cc-table-manager-profile-menu-separator"></div>

                                        <button
                                            type="button"
                                            data-action="deleteGlobalFilterGroup"
                                        >
                                            <i class="fas fa-trash"></i>
                                            {{localize "COMPENDIUM_CURATOR.DeleteFilterGroup"}}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{/each}}
                {{else}}
                    <p class="cc-table-manager-empty">
                        {{localize "COMPENDIUM_CURATOR.NoFilterGroups"}}
                    </p>
                {{/if}}
            </div>
        {{else}}
            <div class="cc-table-manager-profiles">
                {{#if hasProfiles}}
                    {{#each profiles}}
                        <div
                            class="cc-table-manager-profile"
                            data-profile-id="{{id}}"
                            data-cc-search-text="{{searchText}}"
                        >
                            <div class="cc-table-manager-profile-info">
                                <strong>{{name}}</strong>
                                <span>
                                    <i class="{{typeIcon}}"></i>
                                    {{typeLabel}} · {{summary}}
                                </span>

                                {{#if filterGroups.length}}
                                    <div class="cc-table-manager-filter-groups">
                                        {{#each filterGroups}}
                                            <div
                                                class="cc-table-manager-filter-group"
                                                data-filter-group-id="{{id}}"
                                            >
                                                <i class="fas fa-filter"></i>
                                                <span>{{name}}</span>
                                                <button
                                                    type="button"
                                                    class="cc-table-manager-filter-group-control"
                                                    data-action="unlinkFilterGroup"
                                                    title="{{localize 'COMPENDIUM_CURATOR.UnlinkFilterGroup'}}"
                                                >
                                                    <i class="fas fa-link-slash"></i>
                                                </button>
                                            </div>
                                        {{/each}}
                                    </div>
                                {{/if}}
                            </div>

                            <div class="cc-table-manager-profile-status">
                                {{status}}
                            </div>

                            <div class="cc-table-manager-primary-actions">
                                <button
                                    type="button"
                                    class="cc-table-manager-generate-button"
                                    data-action="generateProfile"
                                    {{#unless canGenerate}}disabled{{/unless}}
                                >
                                    <i class="fas fa-wand-magic-sparkles"></i>
                                    {{localize generationActionLabel}}
                                </button>

                                {{#if hasGenerated}}
                                    <button
                                        type="button"
                                        class="cc-table-manager-quick-draw-button"
                                        data-action="quickDrawGeneratedTable"
                                        data-tooltip="COMPENDIUM_CURATOR.QuickDrawGeneratedTableHint"
                                        aria-label="{{localize 'COMPENDIUM_CURATOR.QuickDrawGeneratedTable'}}"
                                    >
                                        <i class="fas fa-box-open"></i>
                                    </button>
                                {{/if}}
                            </div>

                            <div class="cc-table-manager-profile-menu-wrapper">
                                <button
                                    type="button"
                                    class="cc-table-manager-profile-menu-toggle"
                                    data-action="toggleProfileActions"
                                >
                                    <i class="fas fa-gear"></i>
                                    {{localize "COMPENDIUM_CURATOR.Actions"}}
                                </button>

                                <div
                                    class="cc-table-manager-profile-menu"
                                    hidden
                                >
                                    {{#if hasGenerated}}
                                        <button
                                            type="button"
                                            data-action="drawGeneratedTable"
                                        >
                                            <i class="fas fa-dice-d20"></i>
                                            {{localize "COMPENDIUM_CURATOR.DrawGeneratedTable"}}
                                        </button>

                                        <button
                                            type="button"
                                            data-action="openGeneratedTable"
                                        >
                                            <i class="fas fa-table-list"></i>
                                            {{localize "COMPENDIUM_CURATOR.OpenGeneratedTable"}}
                                        </button>
                                    {{/if}}

                                    {{#if isContent}}

                                        <button
                                            type="button"
                                            data-action="previewProfile"
                                            {{#unless filterGroupCount}}disabled{{/unless}}
                                        >
                                            <i class="fas fa-eye"></i>
                                            {{localize "COMPENDIUM_CURATOR.TableProfilePreview"}}
                                        </button>

                                        <button
                                            type="button"
                                            data-action="manualInclusions"
                                        >
                                            <i class="fas fa-plus-circle"></i>
                                            {{localize "COMPENDIUM_CURATOR.ManualInclusions"}}
                                        </button>

                                        <button
                                            type="button"
                                            data-action="manualExclusions"
                                            {{#unless filterGroupCount}}disabled{{/unless}}
                                        >
                                            <i class="fas fa-ban"></i>
                                            {{localize "COMPENDIUM_CURATOR.ManualExclusions"}}
                                        </button>

                                        <div class="cc-table-manager-profile-menu-separator"></div>

                                        <button
                                            type="button"
                                            data-action="addCurrentFilters"
                                        >
                                            <i class="fas fa-filter"></i>
                                            {{localize "COMPENDIUM_CURATOR.ManageFilterGroups"}}
                                        </button>

                                        <div class="cc-table-manager-profile-menu-separator"></div>
                                    {{/if}}

                                    <button
                                        type="button"
                                        data-action="renameProfile"
                                    >
                                        <i class="fas fa-pen"></i>
                                        {{localize "COMPENDIUM_CURATOR.RenameProfile"}}
                                    </button>

                                    <button
                                        type="button"
                                        data-action="duplicateProfile"
                                    >
                                        <i class="fas fa-copy"></i>
                                        {{localize "COMPENDIUM_CURATOR.DuplicateProfile"}}
                                    </button>

                                    <button
                                        type="button"
                                        data-action="exportProfileBundle"
                                    >
                                        <i class="fas fa-file-export"></i>
                                        {{localize "COMPENDIUM_CURATOR.ExportTableProfile"}}
                                    </button>

                                    <div class="cc-table-manager-profile-menu-separator"></div>

                                    <button
                                        type="button"
                                        data-action="deleteProfile"
                                    >
                                        <i class="fas fa-trash"></i>
                                        {{localize "COMPENDIUM_CURATOR.DeleteProfile"}}
                                    </button>
                                </div>
                            </div>

                            {{#if isContent}}
                                <details
                                    class="cc-table-manager-content-inspector"
                                    data-cc-content-inspector
                                    {{#if inspectorOpen}}open{{/if}}
                                    style="
                                        grid-column: 1 / -1;
                                        margin-top: 0.15rem;
                                        padding-top: 0.65rem;
                                        border-top: 1px solid rgb(255 255 255 / 7%);
                                    "
                                >
                                    <summary
                                        style="
                                            display: flex;
                                            align-items: center;
                                            justify-content: space-between;
                                            gap: 1rem;
                                            min-height: 34px;
                                            padding: 0.4rem 0.55rem;
                                            cursor: pointer;
                                            background: rgb(0 0 0 / 16%);
                                            border-radius: 5px;
                                            list-style: none;
                                        "
                                    >
                                        <span>
                                            <i class="fas fa-chevron-down"></i>
                                            {{localize "COMPENDIUM_CURATOR.EditContent"}}
                                        </span>
                                        <strong>
                                            {{localize
                                                "COMPENDIUM_CURATOR.GroupObjectCount"
                                                count=inspector.finalCount
                                            }}
                                        </strong>
                                    </summary>

                                    <div
                                        style="
                                            display: flex;
                                            flex-direction: column;
                                            gap: 0.75rem;
                                            padding: 0.75rem 0 0.15rem;
                                        "
                                    >
                                        <div
                                            class="cc-table-filter-group-matches-title"
                                            style="margin-bottom: 0;"
                                        >
                                            <h3>
                                                {{localize "COMPENDIUM_CURATOR.FinalObjects"}}
                                            </h3>
                                            <strong>{{inspector.finalCount}}</strong>
                                        </div>

                                        {{#if inspector.hasUnavailableObjects}}
                                            <p
                                                class="notification warning"
                                                style="margin: 0; padding: 0.55rem 0.7rem;"
                                            >
                                                <i class="fas fa-triangle-exclamation"></i>
                                                {{localize
                                                    "COMPENDIUM_CURATOR.UnavailableProfileObjects"
                                                    count=inspector.unavailableCount
                                                }}
                                            </p>
                                        {{/if}}

                                        <div class="cc-table-filter-detail-block">
                                            <div class="cc-table-filter-detail-heading">
                                                <strong>
                                                    {{localize "COMPENDIUM_CURATOR.Distribution"}}
                                                </strong>
                                            </div>

                                            <div
                                                style="
                                                    display: grid;
                                                    grid-template-columns: minmax(140px, 1fr) minmax(180px, 1.3fr);
                                                    gap: 0.55rem 0.8rem;
                                                    align-items: center;
                                                "
                                            >
                                                <label for="cc-distribution-mode-{{id}}">
                                                    {{localize "COMPENDIUM_CURATOR.DistributionMode"}}
                                                </label>

                                                <select
                                                    id="cc-distribution-mode-{{id}}"
                                                    data-cc-distribution-mode
                                                >
                                                    <option
                                                        value="individual"
                                                        {{#if inspector.isIndividual}}selected{{/if}}
                                                    >
                                                        {{localize "COMPENDIUM_CURATOR.DistributionIndividual"}}
                                                    </option>
                                                    <option
                                                        value="grouped"
                                                        {{#if inspector.isGrouped}}selected{{/if}}
                                                    >
                                                        {{localize "COMPENDIUM_CURATOR.DistributionGrouped"}}
                                                    </option>
                                                </select>

                                                {{#if inspector.isGrouped}}
                                                    <label for="cc-distribution-grouping-{{id}}">
                                                        {{localize "COMPENDIUM_CURATOR.GroupBy"}}
                                                    </label>

                                                    <select
                                                        id="cc-distribution-grouping-{{id}}"
                                                        data-cc-grouping-criterion
                                                    >
                                                        <option
                                                            value="rarity"
                                                            {{#if inspector.isGroupingRarity}}selected{{/if}}
                                                        >
                                                            {{localize "COMPENDIUM_CURATOR.GroupByRarity"}}
                                                        </option>
                                                        <option
                                                            value="type"
                                                            {{#if inspector.isGroupingType}}selected{{/if}}
                                                        >
                                                            {{localize "COMPENDIUM_CURATOR.GroupByType"}}
                                                        </option>
                                                        <option
                                                            value="source"
                                                            {{#if inspector.isGroupingSource}}selected{{/if}}
                                                        >
                                                            {{localize "COMPENDIUM_CURATOR.GroupBySource"}}
                                                        </option>
                                                        <option
                                                            value="cr"
                                                            {{#if inspector.isGroupingCr}}selected{{/if}}
                                                        >
                                                            {{localize "COMPENDIUM_CURATOR.GroupByChallengeRating"}}
                                                        </option>
                                                        <option
                                                            value="spellLevel"
                                                            {{#if inspector.isGroupingSpellLevel}}selected{{/if}}
                                                        >
                                                            {{localize "COMPENDIUM_CURATOR.GroupBySpellLevel"}}
                                                        </option>
                                                        <option
                                                            value="creatureType"
                                                            {{#if inspector.isGroupingCreatureType}}selected{{/if}}
                                                        >
                                                            {{localize "COMPENDIUM_CURATOR.GroupByCreatureType"}}
                                                        </option>
                                                        <option
                                                            value="size"
                                                            {{#if inspector.isGroupingSize}}selected{{/if}}
                                                        >
                                                            {{localize "COMPENDIUM_CURATOR.GroupBySize"}}
                                                        </option>
                                                        <option
                                                            value="spellSchool"
                                                            {{#if inspector.isGroupingSpellSchool}}selected{{/if}}
                                                        >
                                                            {{localize "COMPENDIUM_CURATOR.GroupBySpellSchool"}}
                                                        </option>
                                                        <option
                                                            value="manual"
                                                            {{#if inspector.isGroupingManual}}selected{{/if}}
                                                        >
                                                            {{localize "COMPENDIUM_CURATOR.GroupByManual"}}
                                                        </option>
                                                    </select>

                                                    {{#if inspector.isRangeGrouping}}
                                                        <span></span>

                                                        <button
                                                            type="button"
                                                            data-action="editGroupingRanges"
                                                            style="
                                                                justify-self: end;
                                                                width: auto;
                                                                min-width: 0;
                                                                padding-inline: 0.75rem;
                                                            "
                                                        >
                                                            <i class="fas fa-sliders"></i>
                                                            {{localize "COMPENDIUM_CURATOR.EditRanges"}}
                                                        </button>
                                                    {{/if}}

                                                    {{#if inspector.isGroupingManual}}
                                                        <span></span>

                                                        <button
                                                            type="button"
                                                            data-action="editManualGroups"
                                                            style="
                                                                justify-self: end;
                                                                width: auto;
                                                                min-width: 0;
                                                                padding-inline: 0.75rem;
                                                            "
                                                        >
                                                            <i class="fas fa-layer-group"></i>
                                                            {{localize "COMPENDIUM_CURATOR.EditManualGroups"}}
                                                        </button>
                                                    {{/if}}
                                                {{/if}}
                                            </div>

                                            <p class="hint" style="margin: 0.55rem 0 0;">
                                                {{#if inspector.isGrouped}}
                                                    {{localize "COMPENDIUM_CURATOR.DistributionGroupedHint"}}
                                                {{else}}
                                                    {{localize "COMPENDIUM_CURATOR.DistributionIndividualHint"}}
                                                {{/if}}
                                            </p>
                                        </div>

                                        {{#if inspector.isGrouped}}
                                            <div class="cc-table-filter-detail-block">
                                                <div class="cc-table-filter-detail-heading">
                                                    <strong>
                                                        {{inspector.groupSectionLabel}}
                                                    </strong>
                                                </div>

                                                {{#if inspector.hasObjects}}
                                                    <div class="cc-table-filter-detail-choices">
                                                        {{#each inspector.groups}}
                                                            <div
                                                                class="cc-table-filter-detail-choice"
                                                                style="align-items: center;"
                                                            >
                                                                <input
                                                                    type="checkbox"
                                                                    data-cc-group-enabled
                                                                    data-group-key="{{key}}"
                                                                    aria-label="{{localize 'COMPENDIUM_CURATOR.IncludeGroup'}}: {{label}}"
                                                                    title="{{localize 'COMPENDIUM_CURATOR.IncludeGroup'}}"
                                                                    {{#if enabled}}checked{{/if}}
                                                                    style="flex: 0 0 auto; margin: 0;"
                                                                >

                                                                <span>{{label}}</span>

                                                                <div
                                                                    style="
                                                                        display: flex;
                                                                        align-items: center;
                                                                        justify-content: flex-end;
                                                                        gap: 0.6rem;
                                                                        flex: 0 0 auto;
                                                                    "
                                                                >
                                                                    <span class="hint">
                                                                        {{localize
                                                                            "COMPENDIUM_CURATOR.GroupObjectCount"
                                                                            count=count
                                                                        }}
                                                                    </span>

                                                                    {{#unless enabled}}
                                                                        <span class="hint">
                                                                            {{localize "COMPENDIUM_CURATOR.GroupExcluded"}}
                                                                        </span>
                                                                    {{/unless}}

                                                                    <strong
                                                                        data-cc-group-probability
                                                                        data-group-key="{{key}}"
                                                                        style="min-width: 58px; text-align: right;"
                                                                    >
                                                                        {{probability}}
                                                                    </strong>

                                                                    <label
                                                                        class="hint"
                                                                        for="cc-group-weight-{{../id}}-{{key}}"
                                                                        style="margin: 0; white-space: nowrap;"
                                                                    >
                                                                        {{localize "COMPENDIUM_CURATOR.GroupWeight"}}
                                                                    </label>

                                                                    <input
                                                                        id="cc-group-weight-{{../id}}-{{key}}"
                                                                        type="number"
                                                                        min="0.000001"
                                                                        step="any"
                                                                        value="{{weight}}"
                                                                        data-cc-group-weight
                                                                        data-group-key="{{key}}"
                                                                        aria-label="{{localize 'COMPENDIUM_CURATOR.GroupWeight'}}: {{label}}"
                                                                        {{#unless enabled}}disabled{{/unless}}
                                                                        style="
                                                                            flex: 0 0 64px;
                                                                            width: 64px;
                                                                            height: 28px;
                                                                            text-align: right;
                                                                        "
                                                                    >
                                                                </div>
                                                            </div>
                                                        {{/each}}
                                                    </div>
                                                {{/if}}
                                            </div>

                                            {{#if inspector.hasObjects}}
                                                {{#each inspector.groups}}
                                                    <details
                                                        style="
                                                            background: rgb(0 0 0 / 12%);
                                                            border-radius: 5px;
                                                        "
                                                    >
                                                        <summary
                                                            style="
                                                                display: flex;
                                                                align-items: center;
                                                                justify-content: space-between;
                                                                gap: 1rem;
                                                                padding: 0.5rem 0.65rem;
                                                                cursor: pointer;
                                                                list-style: none;
                                                            "
                                                        >
                                                            <span>
                                                                <i class="fas fa-chevron-down"></i>
                                                                {{label}}
                                                            </span>

                                                            <div
                                                                style="
                                                                    display: flex;
                                                                    align-items: center;
                                                                    gap: 0.65rem;
                                                                "
                                                            >
                                                                {{#unless enabled}}
                                                                    <span class="hint">
                                                                        {{localize "COMPENDIUM_CURATOR.GroupExcluded"}}
                                                                    </span>
                                                                {{/unless}}
                                                                <strong>{{count}}</strong>
                                                                <span
                                                                    class="hint"
                                                                    data-cc-group-probability
                                                                    data-group-key="{{key}}"
                                                                    style="min-width: 58px; text-align: right;"
                                                                >
                                                                    {{probability}}
                                                                </span>
                                                            </div>
                                                        </summary>

                                                        <div style="padding: 0 0.55rem 0.55rem;">
                                                            <section class="inventory-element cc-dnd5e-document-list">
                                                                <section class="items-list browser-results">
                                                                    <div class="items-section card">
                                                                        <div class="items-header header">
                                                                            <h3 class="item-name">
                                                                                {{localize "DND5E.CompendiumBrowser.Column.Results"}}
                                                                            </h3>

                                                                            <div class="item-header item-source">
                                                                                {{localize "DND5E.CompendiumBrowser.Column.Source"}}
                                                                            </div>

                                                                            <div
                                                                                class="item-header item-controls"
                                                                                style="
                                                                                    flex: 0 0 162px;
                                                                                    min-width: 162px;
                                                                                    display: flex;
                                                                                    align-items: center;
                                                                                    justify-content: flex-end;
                                                                                    gap: 0.25rem;
                                                                                "
                                                                            >
                                                                                <span style="flex: 0 0 54px; text-align: center;">
                                                                                    {{localize "COMPENDIUM_CURATOR.Weight"}}
                                                                                </span>
