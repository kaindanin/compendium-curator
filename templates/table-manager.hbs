<section class="cc-table-manager">

    <header class="cc-table-manager-header">

        <div>
            <h2>
                {{localize
                    "COMPENDIUM_CURATOR.TableProfiles"
                }}
            </h2>

            <p class="hint">
                {{localize
                    "COMPENDIUM_CURATOR.TableProfilesHint"
                }}
            </p>
        </div>

        <div class="cc-table-manager-actions">

            <button
                type="button"
                data-action="configureDefaults"
            >
                <i class="fas fa-gear"></i>

                {{localize
                    "COMPENDIUM_CURATOR.TableDefaults"
                }}
            </button>

        </div>

    </header>


    <nav
        class="tabs"
        aria-label="{{localize 'COMPENDIUM_CURATOR.TableManagerTitle'}}"
    >

        <a
            class="item {{contentTabClass}}"
            role="button"
            data-action="changeManagerTab"
            data-tab="content"
        >
            {{localize
                "COMPENDIUM_CURATOR.TableManagerTabContent"
            }}

            <span>
                ({{contentProfileCount}})
            </span>
        </a>

        <a
            class="item {{nestedTabClass}}"
            role="button"
            data-action="changeManagerTab"
            data-tab="nested"
        >
            {{localize
                "COMPENDIUM_CURATOR.TableManagerTabNested"
            }}

            <span>
                ({{nestedProfileCount}})
            </span>
        </a>

        <a
            class="item {{filterGroupsTabClass}}"
            role="button"
            data-action="changeManagerTab"
            data-tab="filters"
        >
            {{localize
                "COMPENDIUM_CURATOR.TableManagerTabFilterGroups"
            }}

            <span>
                ({{filterGroupCount}})
            </span>
        </a>

    </nav>


    <div class="cc-table-profile-list">

        <div class="filter-element cc-table-manager-actions">

            <search
                aria-label="{{searchLabel}}"
                style="flex: 1 1 auto;"
            >

                <input
                    type="text"
                    name="managerSearch"
                    value="{{searchQuery}}"
                    placeholder="{{searchLabel}}"
                    autocomplete="off"
                >

                <ul class="unlist controls">
                    <li>
                        <button
                            type="button"
                            class="unbutton filter-control"
                            data-action="clearManagerSearch"
                            aria-label="{{localize 'DND5E.FilterClear'}}"
                        >
                            <i class="fas fa-xmark"></i>
                        </button>
                    </li>
                </ul>

            </search>

            <button
                type="button"
                class="cc-table-manager-filter-group-control"
                data-action="createProfile"
                {{#if isFilterGroupsTab}}
                    aria-label="{{localize 'COMPENDIUM_CURATOR.CreateFilterGroup'}}"
                    title="{{localize 'COMPENDIUM_CURATOR.CreateFilterGroup'}}"
                {{else}}
                    {{#if isNestedTab}}
                        aria-label="{{localize 'COMPENDIUM_CURATOR.CreateTableProfile'}}: {{localize 'COMPENDIUM_CURATOR.TableProfileTypeNested'}}"
                        title="{{localize 'COMPENDIUM_CURATOR.CreateTableProfile'}}: {{localize 'COMPENDIUM_CURATOR.TableProfileTypeNested'}}"
                    {{else}}
                        aria-label="{{localize 'COMPENDIUM_CURATOR.CreateTableProfile'}}: {{localize 'COMPENDIUM_CURATOR.TableProfileTypeContent'}}"
                        title="{{localize 'COMPENDIUM_CURATOR.CreateTableProfile'}}: {{localize 'COMPENDIUM_CURATOR.TableProfileTypeContent'}}"
                    {{/if}}
                {{/if}}
            >
                <i class="fas fa-plus"></i>
            </button>

        </div>


        {{#if isFilterGroupsTab}}

            <div class="cc-table-manager-profiles">

                {{#if hasFilterGroups}}

                    {{#each filterGroups}}

                        <div
                            class="cc-table-manager-profile"
                            data-filter-group-id="{{id}}"
                            data-cc-search-text="{{searchText}}"
                        >

                            <div
                                class="cc-table-manager-profile-info"
                            >

                                <strong>
                                    {{name}}
                                </strong>

                                <span>
                                    <i class="fas fa-filter"></i>
                                    {{matchesLabel}}
                                </span>

                                {{#if usedBy.length}}

                                    <div
                                        class="cc-table-manager-filter-groups"
                                    >

                                        {{#each usedBy}}

                                            <div
                                                class="cc-table-manager-filter-group"
                                            >
                                                <i class="fas fa-link"></i>

                                                <span>
                                                    {{name}}
                                                </span>
                                            </div>

                                        {{/each}}

                                    </div>

                                {{else}}

                                    <p class="hint">
                                        {{localize
                                            "COMPENDIUM_CURATOR.FilterGroupUnused"
                                        }}
                                    </p>

                                {{/if}}

                            </div>

                            <div
                                class="cc-table-manager-profile-status"
                            >
                                {{usageLabel}}
                            </div>

                            <div
                                class="cc-table-manager-filter-group-actions"
                            >

                                <button
                                    type="button"
                                    class="cc-table-manager-filter-group-control"
                                    data-action="filterGroupDetails"
                                    title="{{localize 'COMPENDIUM_CURATOR.FilterGroupDetails'}}"
                                >
                                    <i class="fas fa-info-circle"></i>
                                </button>

                                <button
                                    type="button"
                                    class="cc-table-manager-filter-group-control"
                                    data-action="refreshFilterGroup"
                                    title="{{localize 'COMPENDIUM_CURATOR.RefreshFilterGroup'}}"
                                >
                                    <i class="fas fa-arrows-rotate"></i>
                                </button>

                                <button
                                    type="button"
                                    class="cc-table-manager-filter-group-control"
                                    data-action="loadFilterGroup"
                                    title="{{localize 'COMPENDIUM_CURATOR.LoadFilterGroupFilters'}}"
                                >
                                    <i class="fas fa-arrow-up-from-bracket"></i>
                                </button>

                                <div
                                    class="cc-table-manager-profile-menu-wrapper"
                                >

                                    <button
                                        type="button"
                                        class="cc-table-manager-profile-menu-toggle"
                                        data-action="toggleProfileActions"
                                    >
                                        <i class="fas fa-gear"></i>

                                        {{localize
                                            "COMPENDIUM_CURATOR.Actions"
                                        }}
                                    </button>

                                    <div
                                        class="cc-table-manager-profile-menu"
                                        hidden
                                    >

                                        <button
                                            type="button"
                                            data-action="renameFilterGroup"
                                        >
                                            <i class="fas fa-pen"></i>

                                            {{localize
                                                "COMPENDIUM_CURATOR.RenameFilterGroup"
                                            }}
                                        </button>

                                        <button
                                            type="button"
                                            data-action="duplicateFilterGroup"
                                        >
                                            <i class="fas fa-copy"></i>

                                            {{localize
                                                "COMPENDIUM_CURATOR.DuplicateFilterGroup"
                                            }}
                                        </button>

                                        <div
                                            class="cc-table-manager-profile-menu-separator"
                                        ></div>

                                        <button
                                            type="button"
                                            data-action="deleteGlobalFilterGroup"
                                        >
                                            <i class="fas fa-trash"></i>

                                            {{localize
                                                "COMPENDIUM_CURATOR.DeleteFilterGroup"
                                            }}
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    {{/each}}

                {{else}}

                    <p class="cc-table-manager-empty">
                        {{localize
                            "COMPENDIUM_CURATOR.NoFilterGroups"
                        }}
                    </p>

                {{/if}}

            </div>

        {{else}}

            <div class="cc-table-manager-profiles">

                {{#if hasProfiles}}

                    {{#each profiles}}

                        <div
                            class="cc-table-manager-profile"
                            data-profile-id="{{id}}"
                            data-cc-search-text="{{searchText}}"
                        >

                            <div
                                class="cc-table-manager-profile-info"
                            >

                                <strong>
                                    {{name}}
                                </strong>

                                <span>
                                    <i class="{{typeIcon}}"></i>

                                    {{typeLabel}}

                                    ·

                                    {{summary}}
                                </span>

                                {{#if filterGroups.length}}

                                    <div class="cc-table-manager-filter-groups">

                                        {{#each filterGroups}}

                                            <div
                                                class="cc-table-manager-filter-group"
                                                data-filter-group-id="{{id}}"
                                            >

                                                <i class="fas fa-filter"></i>

                                                <span>
                                                    {{name}}
                                                </span>

                                                <button
                                                    type="button"
                                                    class="cc-table-manager-filter-group-control"
                                                    data-action="unlinkFilterGroup"
                                                    title="{{localize 'COMPENDIUM_CURATOR.UnlinkFilterGroup'}}"
                                                >
                                                    <i class="fas fa-link-slash"></i>
                                                </button>

                                            </div>

                                        {{/each}}

                                    </div>

                                {{/if}}

                            </div>

                            <div
                                class="cc-table-manager-profile-status"
                            >
                                {{status}}
                            </div>

                            <div
                                class="cc-table-manager-profile-menu-wrapper"
                            >

                                <button
                                    type="button"
                                    class="cc-table-manager-profile-menu-toggle"
                                    data-action="toggleProfileActions"
                                >
                                    <i class="fas fa-gear"></i>

                                    {{localize
                                        "COMPENDIUM_CURATOR.Actions"
                                    }}
                                </button>

                                <div
                                    class="cc-table-manager-profile-menu"
                                    hidden
                                >

                                    {{#if isContent}}

                                        <button
                                            type="button"
                                            data-action="previewProfile"
                                            {{#unless filterGroupCount}}
                                                disabled
                                            {{/unless}}
                                        >
                                            <i class="fas fa-eye"></i>

                                            {{localize
                                                "COMPENDIUM_CURATOR.TableProfilePreview"
                                            }}
                                        </button>

                                        <button
                                            type="button"
                                            data-action="manualInclusions"
                                        >
                                            <i class="fas fa-plus-circle"></i>

                                            {{localize
                                                "COMPENDIUM_CURATOR.ManualInclusions"
                                            }}
                                        </button>

                                        <button
                                            type="button"
                                            data-action="manualExclusions"
                                            {{#unless filterGroupCount}}
                                                disabled
                                            {{/unless}}
                                        >
                                            <i class="fas fa-ban"></i>

                                            {{localize
                                                "COMPENDIUM_CURATOR.ManualExclusions"
                                            }}
                                        </button>

                                        <div
                                            class="cc-table-manager-profile-menu-separator"
                                        ></div>

                                        <button
                                            type="button"
                                            data-action="addCurrentFilters"
                                        >
                                            <i class="fas fa-filter"></i>

                                            {{localize
                                                "COMPENDIUM_CURATOR.ManageFilterGroups"
                                            }}
                                        </button>

                                        <div
                                            class="cc-table-manager-profile-menu-separator"
                                        ></div>

                                    {{/if}}

                                    <button
                                        type="button"
                                        data-action="renameProfile"
                                    >
                                        <i class="fas fa-pen"></i>

                                        {{localize
                                            "COMPENDIUM_CURATOR.RenameProfile"
                                        }}
                                    </button>

                                    <button
                                        type="button"
                                        data-action="duplicateProfile"
                                    >
                                        <i class="fas fa-copy"></i>

                                        {{localize
                                            "COMPENDIUM_CURATOR.DuplicateProfile"
                                        }}
                                    </button>

                                    <div
                                        class="cc-table-manager-profile-menu-separator"
                                    ></div>

                                    <button
                                        type="button"
                                        data-action="deleteProfile"
                                    >
                                        <i class="fas fa-trash"></i>

                                        {{localize
                                            "COMPENDIUM_CURATOR.DeleteProfile"
                                        }}
                                    </button>

                                </div>

                            </div>

                            {{#if isContent}}

                                <details
                                    class="cc-table-manager-content-inspector"
                                    style="
                                        grid-column: 1 / -1;
                                        margin-top: 0.15rem;
                                        padding-top: 0.65rem;
                                        border-top: 1px solid rgb(255 255 255 / 7%);
                                    "
                                >

                                    <summary
                                        style="
                                            display: flex;
                                            align-items: center;
                                            justify-content: space-between;
                                            gap: 1rem;
                                            min-height: 34px;
                                            padding: 0.4rem 0.55rem;
                                            cursor: pointer;
                                            background: rgb(0 0 0 / 16%);
                                            border-radius: 5px;
                                            list-style: none;
                                        "
                                    >

                                        <span>
                                            <i class="fas fa-chevron-down"></i>
                                            {{localize
                                                "COMPENDIUM_CURATOR.EditContent"
                                            }}
                                        </span>

                                        <strong>
                                            {{localize
                                                "COMPENDIUM_CURATOR.GroupObjectCount"
                                                count=inspector.finalCount
                                            }}
                                        </strong>

                                    </summary>

                                    <div
                                        style="
                                            display: flex;
                                            flex-direction: column;
                                            gap: 0.75rem;
                                            padding: 0.75rem 0 0.15rem;
                                        "
                                    >

                                        <div
                                            class="cc-table-filter-group-matches-title"
                                            style="margin-bottom: 0;"
                                        >
                                            <h3>
                                                {{localize
                                                    "COMPENDIUM_CURATOR.FinalObjects"
                                                }}
                                            </h3>

                                            <strong>
                                                {{inspector.finalCount}}
                                            </strong>
                                        </div>

                                        <div class="cc-table-filter-detail-block">

                                            <div
                                                class="cc-table-filter-detail-heading"
                                            >
                                                <strong>
                                                    {{localize
                                                        "COMPENDIUM_CURATOR.ObjectsByRarity"
                                                    }}
                                                </strong>
                                            </div>

                                            {{#if inspector.hasObjects}}

                                                <div
                                                    class="cc-table-filter-detail-choices"
                                                >

                                                    {{#each inspector.rarityGroups}}

                                                        <div
                                                            class="cc-table-filter-detail-choice"
                                                        >
                                                            <span>
                                                                {{label}}
                                                            </span>

                                                            <strong>
                                                                {{count}}
                                                            </strong>
                                                        </div>

                                                    {{/each}}

                                                </div>

                                            {{/if}}

                                        </div>

                                        {{#if inspector.hasObjects}}

                                            {{#each inspector.rarityGroups}}

                                                <details
                                                    style="
                                                        background: rgb(0 0 0 / 12%);
                                                        border-radius: 5px;
                                                    "
                                                >

                                                    <summary
                                                        style="
                                                            display: flex;
                                                            align-items: center;
                                                            justify-content: space-between;
                                                            gap: 1rem;
                                                            padding: 0.5rem 0.65rem;
                                                            cursor: pointer;
                                                            list-style: none;
                                                        "
                                                    >
                                                        <span>
                                                            <i class="fas fa-chevron-down"></i>
                                                            {{label}}
                                                        </span>

                                                        <strong>
                                                            {{count}}
                                                        </strong>
                                                    </summary>

                                                    <div
                                                        style="padding: 0 0.55rem 0.55rem;"
                                                    >

                                                        <section
                                                            class="inventory-element cc-dnd5e-document-list"
                                                        >
                                                            <section
                                                                class="items-list browser-results"
                                                            >
                                                                <div
                                                                    class="items-section card"
                                                                >
                                                                    <div
                                                                        class="items-header header"
                                                                    >
                                                                        <h3 class="item-name">
                                                                            {{localize
                                                                                "DND5E.CompendiumBrowser.Column.Results"
                                                                            }}
                                                                        </h3>

                                                                        <div
                                                                            class="item-header item-source"
                                                                        >
                                                                            {{localize
                                                                                "DND5E.CompendiumBrowser.Column.Source"
                                                                            }}
                                                                        </div>

                                                                        <div
                                                                            class="item-header item-controls"
                                                                        ></div>
                                                                    </div>

                                                                    <ol
                                                                        class="item-list unlist"
                                                                        style="
                                                                            max-height: 260px;
                                                                            overflow-y: auto;
                                                                        "
                                                                    >

                                                                        {{#each entries}}

                                                                            <li
                                                                                class="item cc-dnd5e-document-entry"
                                                                                data-uuid="{{uuid}}"
                                                                            >
                                                                                <div class="item-row">

                                                                                    <div
                                                                                        class="item-name rollable"
                                                                                        role="button"
                                                                                        data-cc-open-document
                                                                                    >
                                                                                        {{#if img}}
                                                                                            <img
                                                                                                class="item-image gold-icon"
                                                                                                loading="lazy"
                                                                                                src="{{img}}"
                                                                                                alt="{{name}}"
                                                                                                draggable="false"
                                                                                            >
                                                                                        {{/if}}

                                                                                        <div
                                                                                            class="name name-stacked"
                                                                                        >
                                                                                            <span class="title">
                                                                                                {{name}}
                                                                                            </span>

                                                                                            {{#if subtitle}}
                                                                                                <span class="subtitle">
                                                                                                    {{localize subtitle}}
                                                                                                </span>
                                                                                            {{/if}}
                                                                                        </div>
                                                                                    </div>

                                                                                    <div
                                                                                        class="item-detail item-source {{#unless source}}empty{{/unless}}"
                                                                                    >
                                                                                        {{#if source}}
                                                                                            <span class="condensed">
                                                                                                {{source}}
                                                                                            </span>
                                                                                        {{/if}}
                                                                                    </div>

                                                                                    <div
                                                                                        class="item-detail item-controls"
                                                                                    ></div>

                                                                                </div>
                                                                            </li>

                                                                        {{/each}}

                                                                    </ol>
                                                                </div>
                                                            </section>
                                                        </section>

                                                        {{#if truncated}}
                                                            <p
                                                                class="hint"
                                                                style="
                                                                    margin: 0.4rem 0 0;
                                                                    text-align: right;
                                                                "
                                                            >
                                                                {{localize
                                                                    "COMPENDIUM_CURATOR.LivePreview"
                                                                }}:
                                                                {{previewCount}}
                                                                /
                                                                {{count}}
                                                            </p>
                                                        {{/if}}

                                                    </div>

                                                </details>

                                            {{/each}}

                                        {{else}}

                                            <p class="hint">
                                                {{localize
                                                    "COMPENDIUM_CURATOR.NoMatchingObjects"
                                                }}
                                            </p>

                                        {{/if}}

                                    </div>

                                </details>

                            {{/if}}

                        </div>

                    {{/each}}

                {{else}}

                    <p class="cc-table-manager-empty">
                        {{localize
                            "COMPENDIUM_CURATOR.NoTableProfiles"
                        }}
                    </p>

                {{/if}}

            </div>

        {{/if}}

    </div>

</section>