<div class="cc-table-profile-full-preview">

    <h2>
        {{profileName}}
    </h2>

    <div class="cc-table-profile-preview-scroll">

        {{!-- Grupos de filtros --}}
        <section>

            <h3>
                {{localize
                    "COMPENDIUM_CURATOR.FilterGroups"
                }}
            </h3>

            <div
                class="cc-table-filter-detail-block"
            >

                {{#each groups}}

                    <div
                        class="cc-table-filter-detail-choice"
                    >

                        <span>
                            {{name}}
                        </span>

                        <strong>
                            {{count}}
                        </strong>

                    </div>

                {{/each}}

            </div>

        </section>


        {{!-- Resumen --}}
        <section>

            <div
                class="cc-table-filter-detail-block"
            >

                <div
                    class="cc-table-filter-detail-choice"
                >

                    <span>
                        {{localize
                            "COMPENDIUM_CURATOR.TotalFilterMatches"
                        }}
                    </span>

                    <strong>
                        {{totalMatches}}
                    </strong>

                </div>

                <div
                    class="cc-table-filter-detail-choice"
                >

                    <span>
                        {{localize
                            "COMPENDIUM_CURATOR.OverlappingObjects"
                        }}
                    </span>

                    <strong>
                        {{overlappingObjects}}
                    </strong>

                </div>

                <div
                    class="cc-table-filter-detail-choice"
                >

                    <span>
                        {{localize
                            "COMPENDIUM_CURATOR.DuplicatesRemoved"
                        }}
                    </span>

                    <strong>
                        {{duplicateEntriesRemoved}}
                    </strong>

                </div>

                <div
                    class="cc-table-filter-detail-choice"
                >

                    <span>
                        {{localize
                            "COMPENDIUM_CURATOR.ManuallyIncludedObjects"
                        }}
                    </span>

                    <strong>
                        {{manualIncludedCount}}
                    </strong>

                </div>

                <div
                    class="cc-table-filter-detail-choice"
                >

                    <span>
                        {{localize
                            "COMPENDIUM_CURATOR.ManuallyExcludedObjects"
                        }}
                    </span>

                    <strong>
                        {{manualExcludedCount}}
                    </strong>

                </div>

                <div
                    class="cc-table-filter-detail-choice"
                >

                    <span>
                        {{localize
                            "COMPENDIUM_CURATOR.UniqueObjects"
                        }}
                    </span>

                    <strong>
                        {{uniqueCount}}
                    </strong>

                </div>

            </div>

        </section>


        {{!-- Rarezas --}}
        <section>

            <h3>
                {{localize
                    "COMPENDIUM_CURATOR.ObjectsByRarity"
                }}
            </h3>

            <div
                class="cc-table-filter-detail-block"
            >

                {{#each rarityGroups}}

                    <div
                        class="cc-table-filter-detail-choice"
                    >

                        <span>
                            {{label}}
                        </span>

                        <strong>
                            {{count}}
                        </strong>

                    </div>

                {{/each}}

            </div>

        </section>


        {{!-- Objetos finales --}}
        <section
            class="cc-table-profile-preview-results"
        >

            <div
                class="cc-table-filter-group-matches-title"
            >

                <h3>
                    {{localize
                        "COMPENDIUM_CURATOR.FinalObjects"
                    }}
                </h3>

                <strong>
                    {{uniqueCount}}
                </strong>

            </div>


            {{#if hasCandidates}}

                <section
                    class="inventory-element cc-dnd5e-document-list"
                >

                    <section
                        class="items-list browser-results"
                    >

                        <div
                            class="items-section card"
                        >

                            <div
                                class="items-header header"
                            >

                                <h3 class="item-name">
                                    {{localize
                                        "DND5E.CompendiumBrowser.Column.Results"
                                    }}
                                </h3>

                                <div
                                    class="item-header item-source"
                                >
                                    {{localize
                                        "DND5E.CompendiumBrowser.Column.Source"
                                    }}
                                </div>

                                <div
                                    class="item-header item-controls"
                                ></div>

                            </div>


                            <ol class="item-list unlist">

                                {{#each candidates}}

                                    <li
                                        class="item cc-dnd5e-document-entry"
                                        data-uuid="{{uuid}}"
                                    >

                                        <div class="item-row">

                                            <div
                                                class="item-name rollable"
                                                role="button"
                                                data-cc-open-document
                                            >

                                                {{#if img}}

                                                    <img
                                                        class="item-image gold-icon"
                                                        loading="lazy"
                                                        src="{{img}}"
                                                        alt="{{name}}"
                                                        draggable="false"
                                                    >

                                                {{/if}}

                                                <div
                                                    class="name name-stacked"
                                                >

                                                    <span class="title">
                                                        {{name}}
                                                    </span>

                                                    {{#if subtitle}}

                                                        <span class="subtitle">
                                                            {{localize subtitle}}
                                                        </span>

                                                    {{/if}}

                                                </div>

                                            </div>


                                            <div
                                                class="
                                                    item-detail
                                                    item-source
                                                    {{#unless source}}empty{{/unless}}
                                                "
                                            >

                                                {{#if source}}

                                                    <span class="condensed">
                                                        {{source}}
                                                    </span>

                                                {{/if}}

                                            </div>


                                            <div
                                                class="
                                                    item-detail
                                                    item-controls
                                                "
                                            ></div>

                                        </div>

                                    </li>

                                {{/each}}

                            </ol>

                        </div>

                    </section>

                </section>

            {{else}}

                <p class="hint">
                    {{localize
                        "COMPENDIUM_CURATOR.NoMatchingObjects"
                    }}
                </p>

            {{/if}}

        </section>

    </div>

</div>